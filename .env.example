# Flask and database
APP_ENV=production
SECRET_KEY=<generate-a-long-random-secret>
# Persistent IPv4 VPS: copy Supabase's Session pooler URL on port 5432.
SUPABASE_DATABASE_URL=postgresql://<user>:<password>@<pooler-host>:5432/<database>?sslmode=require
SESSION_COOKIE_SECURE=1
# Enable only when Gunicorn is reachable exclusively through one trusted Nginx proxy.
TRUST_PROXY_HEADERS=1
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# Initial administrator
ADMIN_EMAIL=<admin-email>
ADMIN_PASSWORD=<strong-admin-password>

# Existing Razorpay fallback checkout
RAZORPAY_KEY_ID=<razorpay-key-id>
RAZORPAY_KEY_SECRET=<razorpay-key-secret>
RAZORPAY_WEBHOOK_SECRET=<razorpay-webhook-secret>

# GoKwik Checkout
# Enable server APIs first; keep the browser storefront disabled until GoKwik approves sandbox.
GOKWIK_ENABLED=1
GOKWIK_STOREFRONT_ENABLED=0
GOKWIK_ENV=sandbox
GOKWIK_MERCHANT_ID=<gokwik-merchant-id>
GOKWIK_APP_ID=<gokwik-app-id>
GOKWIK_APP_SECRET=<gokwik-app-secret>

# Shiprocket fulfillment
# Create a dedicated API user in Shiprocket Settings > API; do not use the main login.
SHIPROCKET_ENABLED=0
SHIPROCKET_EMAIL=<shiprocket-api-user-email>
SHIPROCKET_PASSWORD=<shiprocket-api-user-password>
# Generate a long random value and configure the same value as the webhook x-api-key.
SHIPROCKET_WEBHOOK_TOKEN=<generate-a-long-random-webhook-token>
# Exact nickname configured in Shiprocket Pickup Addresses.
SHIPROCKET_PICKUP_LOCATION=<pickup-location-nickname>
# Keep this prefix unique for this production store/account.
SHIPROCKET_ORDER_PREFIX=ZUHRAAN-
SHIPROCKET_DEFAULT_WEIGHT_KG=0.5
SHIPROCKET_DEFAULT_LENGTH_CM=10
SHIPROCKET_DEFAULT_BREADTH_CM=10
SHIPROCKET_DEFAULT_HEIGHT_CM=10
# When disabled, an admin must explicitly schedule pickup after AWB assignment.
SHIPROCKET_AUTO_PICKUP=0

# Email and media services
BREVO_API_KEY=<brevo-api-key>
BREVO_SENDER_EMAIL=<sender-email>
BREVO_SENDER_NAME=Zuhraan
CLOUDINARY_URL=cloudinary://<api-key>:<api-secret>@<cloud-name>
