# Flask and database
APP_ENV=production
SECRET_KEY=<generate-a-long-random-secret>
# Persistent IPv4 VPS: copy Supabase's Session pooler URL on port 5432.
SUPABASE_DATABASE_URL=postgresql://<user>:<password>@<pooler-host>:5432/<database>?sslmode=require
SESSION_COOKIE_SECURE=1
# Meta Pixel browser tracking
META_PIXEL_ID=2200260290560993
# Enable only when Gunicorn is reachable exclusively through one trusted Nginx proxy.
TRUST_PROXY_HEADERS=1
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# Razorpay direct checkout
RAZORPAY_ENABLED=1
RAZORPAY_KEY_ID=<razorpay-key-id>
RAZORPAY_KEY_SECRET=<razorpay-key-secret>
RAZORPAY_WEBHOOK_SECRET=<razorpay-webhook-secret>

# Initial administrator
ADMIN_EMAIL=<admin-email>
ADMIN_PASSWORD=<strong-admin-password>

# GoKwik hosted checkout (optional when using direct Razorpay checkout)
GOKWIK_ENABLED=1
GOKWIK_ENV=sandbox
# Enable only after GoKwik onboarding and real sandbox acceptance tests pass.
GOKWIK_PRODUCTION_APPROVED=0
GOKWIK_MERCHANT_ID=<gokwik-merchant-id>
GOKWIK_APP_ID=<gokwik-app-id>
GOKWIK_APP_SECRET=<gokwik-app-secret>

# iThink Logistics fulfillment
# Keep disabled until the database migration and a readiness check pass.
ITHINK_ENABLED=1
ITHINK_ACCESS_TOKEN=<ithink-api-key>
ITHINK_SECRET_KEY=<ithink-secret-key>
ITHINK_PICKUP_ADDRESS_ID=<ithink-pickup-address-id>
ITHINK_RETURN_ADDRESS_ID=<ithink-return-address-id>
# Optional values supplied or confirmed by iThink.
ITHINK_STORE_ID=<ithink-store-id>
ITHINK_API_SOURCE=1
ITHINK_LOGISTICS=
ITHINK_SERVICE_TYPE=surface
ITHINK_DEFAULT_WEIGHT_KG=0.5
ITHINK_DEFAULT_LENGTH_CM=10
ITHINK_DEFAULT_WIDTH_CM=10
ITHINK_DEFAULT_HEIGHT_CM=10

# Email and media services
BREVO_API_KEY=<brevo-api-key>
BREVO_SENDER_EMAIL=<sender-email>
BREVO_SENDER_NAME=Zuhraan
CLOUDINARY_URL=cloudinary://<api-key>:<api-secret>@<cloud-name>
