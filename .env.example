# Flask and database
SECRET_KEY=<generate-a-long-random-secret>
SUPABASE_DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# Initial administrator
ADMIN_EMAIL=<admin-email>
ADMIN_PASSWORD=<strong-admin-password>

# Existing Razorpay fallback checkout
RAZORPAY_KEY_ID=<razorpay-key-id>
RAZORPAY_KEY_SECRET=<razorpay-key-secret>
RAZORPAY_WEBHOOK_SECRET=<razorpay-webhook-secret>

# GoKwik Checkout
# Keep disabled until the sandbox callbacks and merchant endpoints are ready.
GOKWIK_ENABLED=0
GOKWIK_STOREFRONT_ENABLED=0
GOKWIK_ENV=sandbox
GOKWIK_MERCHANT_ID=<gokwik-merchant-id>
GOKWIK_APP_ID=<gokwik-app-id>
GOKWIK_APP_SECRET=<gokwik-app-secret>

# Email and media services
BREVO_API_KEY=<brevo-api-key>
BREVO_SENDER_EMAIL=<sender-email>
BREVO_SENDER_NAME=Zuhraan
CLOUDINARY_URL=cloudinary://<api-key>:<api-secret>@<cloud-name>
